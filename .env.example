# WhatsApp Business API Configuration

# Meta Cloud API Configuration
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_APP_ID=your_app_id
WHATSAPP_APP_SECRET=your_app_secret

# Webhook Configuration
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
WEBHOOK_URL=https://your-domain.com/webhook

# Server Configuration
PORT=3000
NODE_ENV=development

# API Base URLs
META_GRAPH_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# Business Verification
BUSINESS_NAME=Your Business Name
BUSINESS_DESCRIPTION=Your Business Description
BUSINESS_WEBSITE=https://your-website.com
BUSINESS_EMAIL=your-business@email.com

# Logging
LOG_LEVEL=info
LOG_FILE=logs/whatsapp-bot.log

# Optional: Third-party providers (comment out if using Meta Cloud API)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# VONAGE_API_KEY=your_vonage_api_key
# VONAGE_API_SECRET=your_vonage_api_secret
# MESSAGEBIRD_ACCESS_KEY=your_messagebird_access_key